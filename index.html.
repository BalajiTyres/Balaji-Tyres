    .catalogue {
      background: white;
      border-radius: 18px;
      overflow: hidden;
      border: 1px solid #e1e8f0;
      box-shadow: 0 6px 22px #14213d12;
    }

    .catalogue-title {
      background: linear-gradient(135deg, #0b4ea2, #071d49);
      color: white;
      padding: 20px;
      font-size: 24px;
      font-weight: 800;
    }

    /* SEARCH */

    .search-box {
      padding: 20px;
      background: #f7faff;
      border-bottom: 1px solid #e1e8f0;
    }

    .search-box input {
      width: 100%;
      padding: 14px 16px;
      border: 1px solid #cdd9e8;
      border-radius: 10px;
      font-size: 16px;
      outline: none;
    }

    .search-box input:focus {
      border-color: #0b4ea2;
      box-shadow: 0 0 0 3px #0b4ea220;
    }

    .table-wrapper {
      overflow-x: auto;
    }

    .tyre-table {
      width: 100%;
      border-collapse: collapse;
      min-width: 850px;
    }

    .tyre-table th {
      background: #eaf3ff;
      color: #071d49;
      font-weight: 800;
      text-align: left;
      padding: 14px 12px;
      border-bottom: 2px solid #d4e4f7;
      white-space: nowrap;
    }

    .tyre-table td {
      padding: 12px;
      border-bottom: 1px solid #e7edf4;
      color: #26344a;
      white-space: nowrap;
    }

    .tyre-table tr:hover {
      background: #f7fbff;
    }

    .fitment {
      font-weight: 700;
      color: #0b4ea2;
    }

    .type-badge {
      display: inline-block;
      background: #eef4ff;
      color: #0b4ea2;
      padding: 4px 9px;
      border-radius: 20px;
      font-size: 12px;
      font-weight: 700;
