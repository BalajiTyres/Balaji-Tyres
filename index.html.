      margin: auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 15px;
    }

    .logo {
      font-size: 25px;
      font-weight: 800;
    }

    .logo span {
      display: block;
      font-size: 12px;
      letter-spacing: 3px;
      color: #cfe4ff;
    }

    nav a {
      color: white;
      text-decoration: none;
      margin-left: 18px;
      font-weight: 600;
    }

    /* ================= HERO ================= */

    .hero {
      max-width: 1100px;
      margin: 55px auto 0;
      display: grid;
      grid-template-columns: 1.4fr 1fr;
      gap: 35px;
      align-items: center;
    }

    .hero-content h1 {
      font-size: 52px;
      line-height: 1.05;
      margin-bottom: 18px;
    }

    .hero-content h1 span {
      color: #7ec8ff;
    }

    .hero-content p {
      font-size: 19px;
      color: #e4efff;
      margin-bottom: 25px;
    }

    .hero-image {
      text-align: center;
    }

    .tyre-photo {
      width: 280px;
      height: 280px;
      object-fit: contain;
      display: block;
      margin: auto;
    }

    .btns {
      display: flex;
      gap: 12px;
      flex-wrap: wrap;
    }

    .btn {
      display: inline-block;
      padding: 13px 20px;
      border-radius: 10px;
      text-decoration: none;
      font-weight: 700;
    }

    .primary {
      background: #fff;
      color: #0b4ea2;
    }

    .secondary {
      border: 1px solid #bcd8ff;
      color: #fff;
    }

    /* ================= COMMON ================= */

    section {
      max-width: 1100px;
      margin: auto;
      padding: 55px 18px;
    }

    .title {
      text-align: center;
      margin-bottom: 30px;
    }

    .title h2 {
      font-size: 32px;
    }

    .title p {
      color: #65738a;
    }

    /* ================= CARDS ================= */

    .cards {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 18px;
    }

    .card {
      background: white;
      padding: 25px;
      border-radius: 16px;
      box-shadow: 0 6px 22px #14213d12;
      border: 1px solid #e4ebf4;
    }

    .icon {
      font-size: 32px;
      margin-bottom: 8px;
    }

    .card h3 {
      margin-bottom: 7px;
    }

    .card p {
      color: #66758b;
    }

